#!/bin/sh
# Bloque le commit si tests/typecheck/lint échouent
echo "→ pre-commit : lint + typecheck + tests"
npm run lint || { echo "❌ lint KO"; exit 1; }
npm run typecheck || { echo "❌ typecheck KO"; exit 1; }
npm test -- --run || { echo "❌ tests KO"; exit 1; }
# Bloque les secrets évidents
if git diff --cached | grep -qE '(SUPABASE_SERVICE_ROLE|sk_live_|api[_-]?key\s*=\s*["'"'"'][A-Za-z0-9]{20,})'; then
  echo "❌ secret potentiel détecté dans le diff"; exit 1
fi
